<mxfile host="app.diagrams.net" modified="2026-09-09T19:09:00-07:00" agent="ChatGPT" version="24.7.17"><diagram id="pan-ftd-hash" name="PAN-OS vs FTD Hash Exceptions"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="False-Positive File Handling: PAN-OS vs Cisco Secure Firewall/FTD" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1" vertex="1" parent="1"><mxGeometry x="300" y="20" width="1000" height="50" as="geometry"/></mxCell><mxCell id="pan" value="PAN-OS / Panorama" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1" vertex="1" parent="1"><mxGeometry x="80" y="110" width="650" height="60" as="geometry"/></mxCell><mxCell id="ftd" value="Cisco Secure Firewall / FTD + FMC" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1" vertex="1" parent="1"><mxGeometry x="870" y="110" width="650" height="60" as="geometry"/></mxCell><mxCell id="panfile" value="Known-good file\nSHA-256 = H1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16" vertex="1" parent="1"><mxGeometry x="120" y="220" width="220" height="80" as="geometry"/></mxCell><mxCell id="panav" value="Traditional Antivirus signature\nThreat ID = T123\nDetection may be signature/pattern based" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16" vertex="1" parent="1"><mxGeometry x="430" y="210" width="260" height="100" as="geometry"/></mxCell><mxCell id="panexc" value="Signature Exception\nObjects > Security Profiles > Antivirus > Signature Exceptions\nScope: Threat ID/signature, not one SHA-256" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15" vertex="1" parent="1"><mxGeometry x="260" y="380" width="380" height="120" as="geometry"/></mxCell><mxCell id="panml" value="Separate path: WildFire Inline ML\nFile Exception supports hash/partial hash + filename\nThis does NOT turn traditional AV exceptions into SHA-256 allowlisting" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15" vertex="1" parent="1"><mxGeometry x="190" y="570" width="500" height="120" as="geometry"/></mxCell><mxCell id="ftdfile" value="Known-good file\nSHA-256 = H1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16" vertex="1" parent="1"><mxGeometry x="920" y="220" width="220" height="80" as="geometry"/></mxCell><mxCell id="ftdamp" value="Malware/File policy\nCloud disposition says Malware" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16" vertex="1" parent="1"><mxGeometry x="1230" y="220" width="240" height="80" as="geometry"/></mxCell><mxCell id="ftdclean" value="Clean List\nAdd full SHA-256 H1\nFMC treats that exact file as clean for the file policy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15" vertex="1" parent="1"><mxGeometry x="1050" y="390" width="350" height="110" as="geometry"/></mxCell><mxCell id="ftdother" value="Different SHA-256 H2\nStill evaluated normally\nNo broad signature exception required" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15" vertex="1" parent="1"><mxGeometry x="1050" y="570" width="350" height="100" as="geometry"/></mxCell><mxCell id="note" value="Operational consequence: PAN-OS traditional AV false-positive handling can have broader blast radius because the exception is tied to the antivirus Threat ID/signature. Cisco FTD clean-list handling can be scoped to the exact SHA-256." style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1" vertex="1" parent="1"><mxGeometry x="390" y="750" width="820" height="90" as="geometry"/></mxCell><mxCell id="e1" edge="1" parent="1" source="panfile" target="panav" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" edge="1" parent="1" source="panav" target="panexc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" edge="1" parent="1" source="panexc" target="panml" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" edge="1" parent="1" source="ftdfile" target="ftdamp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" edge="1" parent="1" source="ftdamp" target="ftdclean" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" edge="1" parent="1" source="ftdclean" target="ftdother" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" edge="1" parent="1" source="panml" target="note" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" edge="1" parent="1" source="ftdother" target="note" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>